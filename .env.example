# ──────────────────────────────────────────
# PMS 환경 설정 파일
# 이 파일을 복사해서 .env 로 저장 후 값을 수정하세요
# cp .env.example .env
# ──────────────────────────────────────────

# PostgreSQL DB 설정
DB_USER=pms_user
DB_PASSWORD=your_secure_password_here
DB_NAME=pms_db

# JWT 인증 설정 (충분히 긴 랜덤 문자열로 변경하세요)
JWT_SECRET=change-this-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
